# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Get this free from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional — override the model without touching code. Google retires Gemini
# models every few months; if gemini-2.5-flash ever 404s, check
# https://ai.google.dev/gemini-api/docs/models for the current free-tier
# model name and set it here.
GEMINI_MODEL=gemini-2.5-flash
