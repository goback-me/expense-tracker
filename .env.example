# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Get this from https://console.anthropic.com/settings/keys
# NOTE: unlike Gemini, the Claude API has no free tier — you'll need to add
# a payment method at console.anthropic.com. Cost is low though: with the
# default Haiku model below, a single receipt scan costs roughly
# $0.003-0.005, and importing a large multi-page bank statement runs about
# $0.20-0.25 total.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — override the model without touching code. claude-haiku-4-5 is
# the cheapest current vision-capable model, which keeps per-scan cost as
# low as possible. Check https://docs.claude.com/en/docs/about-claude/models/overview
# for the current model list if this one is ever retired.
CLAUDE_MODEL=claude-haiku-4-5-20251001
